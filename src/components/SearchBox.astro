---
// Search box — filters the menu board in the visitor's own browser.
// What is typed here is never sent anywhere.
---
<div class="search-box">
  <label for="menu-search" style="position:absolute;left:-9999px">Search the menu</label>
  <input id="menu-search" type="search" placeholder="Search the menu — try “baconator” or “frosty”" autocomplete="off" />
</div>
