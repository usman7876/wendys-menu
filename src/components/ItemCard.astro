---
import { formatPrice, caloriesLabel } from '../utils/menuStats.js';
const { item, priceBasis } = Astro.props;
const price = formatPrice(item.price);
const calLabel = caloriesLabel(item);
---
<div class="menu-line" data-name={item.name.toLowerCase()} data-category={item.category}>
  <div>
    <span class="name">{item.name}</span>
    <span class="cal">
      {calLabel !== null ? calLabel : 'Calories: Not verified yet'}
    </span>
    {item.note && <span class="item-note">{item.note}</span>}
  </div>
  <span class="dots" aria-hidden="true"></span>
  <span class="price">{price !== null ? price : <span class="not-verified">Not verified yet</span>}</span>
</div>
