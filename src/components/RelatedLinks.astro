---
// "You may also want" — 3–5 related pages at the bottom of every page,
// chosen by topic. Links are passed in by the page.
const { links } = Astro.props;
---
<section class="board related" aria-labelledby="related-heading">
  <h2 id="related-heading">You may also want</h2>
  <ul>
    {links.map((l) => (
      <li><a href={l.href}>{l.label}</a></li>
    ))}
  </ul>
</section>
