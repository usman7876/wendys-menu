---
import CategoryPage from '../components/CategoryPage.astro';
import menuData from '../data/menu.json';
const { items } = menuData;
const catItems = items.filter((i) => i.category === 'Desserts');
---
<CategoryPage
  category="Desserts"
  items={catItems}
  title="Wendy's Desserts Menu Prices 2026 (USA)"
  description="Wendy's desserts menu prices: Classic Chocolate Frosty from $1.39, Frosty Fusions and cookies — with calories, checked 22 Nov 2026 at one Columbus restaurant."
  related={[
    { href: '/wendys-menu-prices', label: "Wendy's full menu — all 150 items with prices" },
    { href: '/wendys-nutrition', label: "Wendy's nutrition — protein, fat, carbs and sodium" },
    { href: '/wendys-calories', label: "Wendy's calories — lowest and highest per category" },
    { href: '/wendys-deals', label: "Wendy's deals — Biggie Bags, Everyday Value and combos" },
  ]}
/>
