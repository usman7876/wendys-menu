---
import BaseLayout from '../layouts/BaseLayout.astro';
import PopularTable from '../components/PopularTable.astro';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import TiltScript from '../components/TiltScript.astro';
import menuData from '../data/menu.json';
import { itemsByCategory, countVerifiedPrices, countVerifiedCalories, categoryStats, formatPrice, itemPhoto, categorySlug, popularItems, dealPhoto } from '../utils/menuStats.js';
import { buildFaqs } from '../utils/faqData.js';

// Landing page only: hero, search, popular cards, category cards, deals
// teaser, trust strip, FAQ teaser. The full menu, breakfast board,
// nutrition table, comparison and hours now live on their own pages.
const { meta, items } = menuData;
const stage5 = { deals: menuData.deals, comparison: menuData.comparison, hours: menuData.hours };
const byCategory = itemsByCategory(items);
const stats = categoryStats(items);

function statsLine(category) {
  const s = stats[category];
  const parts = [`${s.count} items`];
  if (s.minPrice !== null) parts.push(`${formatPrice(s.minPrice)}–${formatPrice(s.maxPrice)}`);
  if (s.avgCalories !== null) parts.push(`avg ${s.avgCalories} cal`);
  return parts.join(' · ');
}

// Deals teaser figures, computed from the data — no hard-coded prices.
const bagPrice = menuData.deals.biggie_bags[0]?.price ?? null;
const bundlePrice = menuData.deals.biggie_bundle.price;
const evMin = Math.min(...menuData.deals.everyday_value.map((d) => d.price));

// Category card photo: the first dish in the category that has an
// exactly-matching photo. Cards link to the category's own page.
const catCards = Object.entries(byCategory).map(([category, catItems]) => {
  const withPhoto = catItems.find((i) => itemPhoto(i.name) !== null);
  return { category, slug: categorySlug(category), photo: withPhoto ? itemPhoto(withPhoto.name) : null, photoAlt: withPhoto ? withPhoto.name : '' };
});
---
<BaseLayout
  title="Wendy's Menu with Prices 2026 (USA)"
  description="Wendy's menu with prices and calories for all 150 items — checked 22 Nov 2026 at one Columbus restaurant. Search the menu and filter by category."
  itemCount={items.length}
  path="/"
  isHome
  faqs={buildFaqs(items, meta.price_basis, stage5).slice(0, 3)}
  itemList={popularItems(items)}
>
  <section class="hero" aria-labelledby="page-title">
    <h1 id="page-title">Wendy's Menu with Prices 2026 (USA)</h1>
    <p class="lede">This is the Wendy's menu with prices and calories for all 150 items — every price checked 22 Nov 2026 at one restaurant in Columbus, Ohio, on Wendy's official online menu.</p>
    <figure class="hero-photo tilt" tabindex="0">
      <img src="/images/hero.webp" alt="Cheeseburger, fries and a chocolate Frosty" width="1920" height="1280" decoding="async" fetchpriority="high" />
    </figure>
    <div class="stats">
      <div class="stat"><b>{items.length}</b><span>verified items</span></div>
      <div class="stat"><b>{countVerifiedPrices(items)}</b><span>with a verified price</span></div>
      <div class="stat"><b>{countVerifiedCalories(items)}</b><span>with verified calories</span></div>
      <div class="stat"><b>22 Nov 2026</b><span>data date</span></div>
    </div>
    <p class="basis">
      <strong>Verified data only:</strong> all prices below are for <strong>{meta.price_basis}</strong>, Carryout, checked on order.wendys.com. This is <strong>not</strong> a national price list. Calories are labelled “from Wendy's official online menu”. Breakfast prices could not be checked and honestly say “Not verified yet”. No third-party menu site was used.
    </p>
  </section>

  <div class="search-bar">
    <form class="search-box" action="/wendys-menu-prices" method="get" role="search">
      <label for="menu-search" style="position:absolute;left:-9999px">Search the menu</label>
      <input id="menu-search" name="q" type="search" placeholder={`Search ${items.length} items…`} autocomplete="off" />
    </form>
    <p class="basis">Type a dish name and press Enter — the full menu opens already filtered.</p>
  </div>

  <section class="board" aria-labelledby="popular-heading">
    <h2 id="popular-heading">Popular prices</h2>
    <p class="board-sub">The items people ask about most, taken from the same verified data list as everything else on this site. All prices are for one restaurant only — 799 S. High St, Columbus, OH, 22 Nov 2026.</p>
    <PopularTable items={items} />
    <p class="basis"><a href="/wendys-menu-prices">See the full menu — all {items.length} items →</a></p>
  </section>

  <AdSlot />

  <section class="board" aria-labelledby="browse-heading">
    <h2 id="browse-heading">Browse by category</h2>
    <p class="board-sub">Six parts of the menu, each with its own count, price range and average calories — all worked out from the verified data.</p>
    <div class="cat-grid">
      {catCards.map((c) => (
        <a class="cat-card tilt" href={`/${c.slug}`} tabindex="0">
          {c.photo && <img src={c.photo} alt={c.photoAlt} width="1920" height="1280" loading="lazy" decoding="async" />}
          <div class="cat-card-body">
            <h3 class="cat-card-name">{c.category}</h3>
            <p class="cat-card-stats">{statsLine(c.category)}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="board" id="deals" aria-labelledby="deals-heading">
    <h2 id="deals-heading">Deals</h2>
    <p class="board-sub">Biggie Deals and Everyday Value — checked 22 Nov 2026 at the same one Columbus restaurant.</p>
    <figure class="hero-photo tilt" tabindex="0">
      <img src={dealPhoto('Jr. Cheeseburger Biggie Bag')} alt="Jr. Cheeseburger Biggie Bag" width="1920" height="1280" loading="lazy" decoding="async" />
    </figure>
    <ul class="teaser-list">
      <li><b>{bagPrice !== null ? formatPrice(bagPrice) : 'Not verified yet'}</b>Biggie Bags — a sandwich, 4 PC Nuggets, a Jr. Fry and a Small Soft Drink.</li>
      <li><b>{formatPrice(bundlePrice)}</b>Biggie Bundle — 2 sandwiches, a Jr. Fry and a Small Soft Drink.</li>
      <li><b>from {formatPrice(evMin)}</b>Everyday Value — low-priced items, no end date shown.</li>
    </ul>
    <p class="basis"><a href="/wendys-deals">See all deals, combos and offers →</a></p>
  </section>

  <AdSlot />

  <section class="board" id="how-we-source-prices">
    <h2>How we source prices</h2>
    <ul class="trust-strip">
      <li>Every price was checked on Wendy's official online menu, order.wendys.com, on 22 Nov 2026.</li>
      <li>All prices are from one named restaurant — Wendy's publishes no national price list.</li>
      <li>Anything not verified says “Not verified yet” — figures are never guessed or borrowed from other sites.</li>
      <li>No third-party menu or price site was used for any figure on this page.</li>
    </ul>
    <p class="basis"><a href="/how-we-source-prices">Read the full sourcing method →</a></p>
  </section>

  <section class="board" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Questions people ask</h2>
    <p class="board-sub">Every answer below is worked out from the same verified data list as the menu, so the numbers here can never disagree with the tables.</p>
    <Faq items={items} priceBasis={meta.price_basis} stage5={stage5} limit={3} />
    <p class="basis"><a href="/wendys-hours">Wendy's breakfast hours and menu →</a> · <a href="/wendys-nutrition">Wendy's nutrition and calories →</a></p>
  </section>
</BaseLayout>

<TiltScript />
