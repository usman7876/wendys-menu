---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import menuData from '../data/menu.json';

const { items } = menuData;
---
<BaseLayout
  title="About This Wendy's Menu Site | Fan Reference"
  description="An independent, fan-run Wendy's menu reference for the USA. Not affiliated with Wendy's, no orders, no official photos. Data checked 22 Nov 2026."
  itemCount={items.length}
  path="/about"
  crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
>
  <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
  <section class="board page-head" aria-labelledby="page-title">
    <h1 id="page-title">About This Site</h1>
    <p class="board-sub">An independent, fan-run reference — not the official Wendy's website.</p>
  </section>

  <section class="board" aria-labelledby="what-heading">
    <h2 id="what-heading">What this site is, and what it is not</h2>
    <p><strong>What this site is:</strong> an independent, fan-run reference for people in the USA who want one quick answer — a price, a calorie count, or breakfast hours — before they visit a Wendy's restaurant.</p>
    <p><strong>What it is not:</strong> it is not the official Wendy's website, it is not run by Wendy's or any franchisee, it does not sell food, and it does not take orders. You cannot buy anything here.</p>
    <p><strong>How it works:</strong> every item, price, calorie count, table and FAQ answer on this site is built from one single verified data list, checked on Wendy's official online menu on 22 Nov 2026. Nothing is typed twice, so the numbers cannot contradict each other. If a figure has not been verified, the page says “Not verified yet” instead of guessing.</p>
    <p><strong>Why prices carry a long label:</strong> Wendy's publishes no national price list, and each restaurant sets its own prices. Every price here is therefore labelled “one restaurant only — 799 S. High St, Columbus, OH, 22 Nov 2026”, so you always know exactly what a price means — and what it does not mean. The price at your local restaurant may be different.</p>
    <p><strong>Images:</strong> All photos on this site are original AI-generated images, not official Wendy's photos.</p>
    <p><strong>Data date:</strong> 22 November 2026 · <strong>Verified items:</strong> {items.length}.</p>
  </section>

  <AdSlot />
  <RelatedLinks links={[
    { href: '/how-we-source-prices', label: 'How we source prices' },
    { href: '/editorial-team', label: 'Editorial team' },
    { href: '/contact', label: 'Contact — report a wrong price' },
    { href: '/wendys-menu-prices', label: "Wendy's full menu — all 155 items with prices" },
  ]} />
</BaseLayout>
