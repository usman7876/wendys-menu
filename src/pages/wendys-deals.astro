---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DealsBoard from '../components/DealsBoard.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import menuData from '../data/menu.json';

const { meta, items } = menuData;
---
<BaseLayout
  title="Wendy's Deals 2026 | Biggie Bags & Value Menu"
  description="Wendy's deals: Biggie Bags $6.00, Biggie Bundle $8.00, Everyday Value from $1.59 — checked 22 Nov 2026 at one Columbus restaurant."
  itemCount={items.length}
  path="/wendys-deals"
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Deals' }]}
>
  <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Deals' }]} />
  <section class="board page-head" aria-labelledby="page-title">
    <h1 id="page-title">Wendy's Deals 2026</h1>
    <p class="board-sub">Wendy's deals at one Columbus restaurant, checked 22 Nov 2026: Biggie Bags $6.00, Biggie Bundle $8.00, Everyday Value from $1.59, plus combos, the Frosty Key Tag and app offers.</p>
    <p class="basis">Deals are bundles, not single items. Biggie Bags, the Biggie Bundle and combos have no total calories shown on Wendy's site, so their totals say “Not verified yet” — only the per-component calories in the builders are shown.</p>
  </section>

  <section class="board" aria-labelledby="deals-heading">
    <h2 id="deals-heading">All deals, combos and offers</h2>
    <DealsBoard deals={menuData.deals} priceBasis={meta.price_basis} />
    <p class="flag"><strong>Flagged, not reconciled:</strong> Wendy's own pages show different calories for the same item — Jr. Cheeseburger 260 Cal (Biggie Bites builder) vs 270 Cal (Everyday Value), Jr. Bacon Cheeseburger 300 vs 350, Double Stack 370 vs 380, Crispy Chicken Sandwich 290 vs 340. Each figure is shown exactly as on its own page.</p>
  </section>

  <AdSlot />
  <RelatedLinks links={[
    { href: '/wendys-menu-prices', label: "Wendy's full menu — all 155 items with prices" },
    { href: '/wendys-vs-mcdonalds', label: "Wendy's vs McDonald's — calories compared" },
    { href: '/wendys-nutrition', label: "Wendy's nutrition — protein, fat, carbs and sodium" },
    { href: '/how-we-source-prices', label: 'How we source prices' },
  ]} />
</BaseLayout>
