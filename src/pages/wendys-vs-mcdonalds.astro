---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ComparisonBoard from '../components/ComparisonBoard.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import menuData from '../data/menu.json';

const { meta, items } = menuData;
---
<BaseLayout
  title="Wendy's vs McDonald's 2026 | Calories Compared"
  description="Wendy's vs McDonald's, calories only: no McDonald's prices were found on mcdonalds.com, so no price winner is named. Similar items, different products."
  itemCount={items.length}
>
  <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: "Wendy's vs McDonald's" }]} />
  <section class="board page-head" aria-labelledby="page-title">
    <h1 id="page-title">Wendy's vs McDonald's 2026</h1>
    <p class="board-sub">Calories only — no price winner can be declared.</p>
    <p class="basis"><strong>No price winner can be declared.</strong> No McDonald's prices were found for any item on mcdonalds.com — the site sends visitors to the McDonald's app for prices — so every McDonald's price below says “Not verified yet — price only in the McDonald's app”. The tables compare calories for similar types only, and they do not say one is better: the items are different products, sizes and recipes.</p>
  </section>

  <section class="board" aria-labelledby="comparison-heading">
    <h2 id="comparison-heading">The comparison</h2>
    <ComparisonBoard items={items} comparison={menuData.comparison} priceBasis={meta.price_basis} />
  </section>

  <AdSlot />
  <RelatedLinks links={[
    { href: '/wendys-menu-prices', label: 'Full menu — all 150 items with prices' },
    { href: '/wendys-calories', label: 'Calories — lowest and highest per category' },
    { href: '/wendys-nutrition', label: 'Nutrition — protein, fat, carbs and sodium' },
    { href: '/wendys-deals', label: 'Deals — Biggie Bags, Everyday Value and combos' },
  ]} />
</BaseLayout>
