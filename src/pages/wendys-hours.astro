---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import HoursBoard from '../components/HoursBoard.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import menuData from '../data/menu.json';

const { items } = menuData;
const hours = menuData.hours;
const thursday = hours.restaurant_hours.find((d) => d.day === 'Thursday');
---
<BaseLayout
  title="Wendy's Hours 2026 | Open, Close & Drive-Thru"
  description="Wendy's hours for one Columbus restaurant: opens 7:00 AM most days, closes 3:00 AM, drive-thru the same — Thursday listed Closed. Checked 22 Nov 2026."
  itemCount={items.length}
  path="/wendys-hours"
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Hours' }]}
>
  <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Hours' }]} />
  <section class="board page-head" aria-labelledby="page-title">
    <h1 id="page-title">Wendy's Hours 2026</h1>
    <p class="board-sub">{hours.restaurant} · Phone {hours.phone} · from locations.wendys.com, checked 22 Nov 2026.</p>
    <p class="basis">What time does this Wendy's open and close? 7:00 AM to 3:00 AM most days (7:30 AM Saturdays and Sundays), restaurant and drive-thru the same — Thursday is listed Closed. Hours vary by restaurant, so check your local Wendy's.</p>
  </section>

  <section class="board" aria-labelledby="hours-heading">
    <h2 id="hours-heading">Restaurant and drive-thru hours</h2>
    <HoursBoard hours={hours} />
    <p class="flag"><strong>Thursday: {thursday.hours} — Needs verification.</strong> The official location page lists Thursday as “Closed” in both the restaurant and drive-thru tables, with no reason given. No reason is invented here, and the closure has not been confirmed by a second check — it is shown exactly as the location page states it.</p>
  </section>

  <AdSlot />
  <RelatedLinks links={[
    { href: '/wendys-breakfast-menu', label: "Wendy's breakfast menu — hours and the 6 morning items" },
    { href: '/wendys-menu-prices', label: "Wendy's full menu — all 150 items with prices" },
    { href: '/wendys-deals', label: "Wendy's deals — Biggie Bags, Everyday Value and combos" },
    { href: '/how-we-source-prices', label: 'How we source prices' },
  ]} />
</BaseLayout>
