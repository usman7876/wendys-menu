---
import '../styles/global.css';
import TopNotice from '../components/TopNotice.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title = "Wendy's Menu with Prices 2026 (USA)",
  description = "Independent, fan-run Wendy's menu reference for the USA. Prices from one restaurant only — Wendy's, 799 S. High St, Columbus, OH, checked 22 Nov 2026. Calories from Wendy's official online menu.",
  itemCount,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script>
      // Dark mode: remember the visitor's choice, otherwise follow the system.
      try {
        const saved = localStorage.getItem('wendys-theme');
        if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <TopNotice />
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer itemCount={itemCount} />
  </body>
</html>
