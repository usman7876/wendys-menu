---
import '../styles/global.css';
import TopNotice from '../components/TopNotice.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title = "Wendy's Menu with Prices 2026 (USA)",
  description = "Independent Wendy's menu reference (USA). Prices from one restaurant only — 799 S. High St, Columbus, OH, checked 22 Nov 2026.",
  itemCount,
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="cream">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script>
      // Theme: two looks — warm cream + tomato-red, and dark charcoal + teal.
      // Remember the visitor's choice; otherwise follow their system setting.
      // "Theme" here means the site's colour look, not Wendy's branding.
      try {
        const saved = localStorage.getItem('wendys-theme');
        const theme =
          saved === 'cream' || saved === 'charcoal'
            ? saved
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'charcoal'
              : 'cream';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'cream');
      }
    </script>
  </head>
  <body>
    <TopNotice />
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer itemCount={itemCount} />
  </body>
</html>
